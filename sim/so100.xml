<?xml version="1.0" encoding="utf-8"?>
<mujoco model="so_arm100">

  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option
    timestep   = "0.001"
    gravity    = "0 0 -9.81"
    integrator = "implicitfast"
    cone       = "elliptic"
    impratio   = "10"
    iterations = "120"
    noslip_iterations = "3"/>

  <!-- ══════════════════════════════════════════════════════════════════
    DEFAULTS
    ─────────────────────────────────────────────────────────────────
    BUG FIX: removed `limited="true"` from arm_joint class.
    When `limited="true"` is set in a default class WITHOUT a range,
    MuJoCo locks the joint at 0. Each joint declares its own range,
    which implicitly enables limits. This was silently locking
    shoulder_pan (and would have locked all joints).
  ══════════════════════════════════════════════════════════════════════ -->
  <default>

    <default class="arm_joint">
      <!-- NO limited="true" here — each joint sets its own range -->
      <joint type="hinge" damping="0.5" frictionloss="0.1" armature="0.01"/>
    </default>

    <!-- Visual mesh geoms — rendering only, zero collision -->
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1" mass="0"/>
    </default>

    <!-- Collision proxy geoms — invisible capsules/boxes -->
    <default class="collision">
      <geom contype="1" conaffinity="1"
            condim="6"
          margin="0.0015"
            friction="0.8 0.02 0.01"
          solref="0.0012 1"
          solimp="0.99 0.999 0.001 0.5 2"
            rgba="0 0 0 0"/>
    </default>

    <!-- Gripper finger proxies — higher friction for grasping -->
    <default class="gripper_col">
      <geom contype="1" conaffinity="1"
            condim="6"
          margin="0.00010"
            friction="1.8 0.02 0.005"
            solref="0.0007 1"
          solimp="0.99 0.999 0.001 0.5 2"
            rgba="0 0 0 0"/>
    </default>

    <default class="arm_act">
      <position kp="80" kv="8" ctrllimited="true" forcelimited="true" forcerange="-8 8"/>
    </default>

  </default>

  <!-- ── Assets ────────────────────────────────────────────────────── -->
  <asset>
    <mesh name="Base"                   file="Base.stl"/>
    <mesh name="Base_Motor"             file="Base_Motor.stl"/>
    <mesh name="Rotation_Pitch"         file="Rotation_Pitch.stl"/>
    <mesh name="Rotation_Pitch_Motor"   file="Rotation_Pitch_Motor.stl"/>
    <mesh name="Upper_Arm"              file="Upper_Arm.stl"/>
    <mesh name="Upper_Arm_Motor"        file="Upper_Arm_Motor.stl"/>
    <mesh name="Lower_Arm"              file="Lower_Arm.stl"/>
    <mesh name="Lower_Arm_Motor"        file="Lower_Arm_Motor.stl"/>
    <mesh name="Wrist_Pitch_Roll"       file="Wrist_Pitch_Roll.stl"/>
    <mesh name="Wrist_Pitch_Roll_Motor" file="Wrist_Pitch_Roll_Motor.stl"/>
    <mesh name="Fixed_Jaw"              file="Fixed_Jaw.stl"/>
    <mesh name="Fixed_Jaw_Motor"        file="Fixed_Jaw_Motor.stl"/>
    <mesh name="Moving_Jaw"             file="Moving_Jaw.stl"/>

    <material name="3d_printed" rgba="1.0 0.82 0.12 1.0"/>
    <material name="sts3215"    rgba="0.1 0.1  0.1  1.0"/>
  </asset>

  <!-- ══════════════════════════════════════════════════════════════════
    WORLDBODY
    ─────────────────────────────────────────────────────────────────
    ARM PLACEMENT (pick-and-place layout):

      Table top surface:  z = 0.46 m
      Arm base:           x=0,    y=-0.25,  z=0.46   (back of table)
      Block (pick):       x=0,    y=-0.08,  z=0.485  (0.215m from shoulder → reachable)
      Place zone:         x=0.15, y=-0.08,  z=0.462  (to the right of block)

    Shoulder world position after offsets:
      y = -0.25 + (-0.0452) = -0.295
      z = 0.46 + 0.0165     =  0.477
    Max horizontal reach (upper 0.1025 + lower 0.135) ≈ 0.237 m
    Block distance from shoulder ≈ 0.215 m  →  comfortably reachable.
  ══════════════════════════════════════════════════════════════════════ -->
  <worldbody>

    <!-- ── Base: fixed to table, no joint ── -->
    <body name="base" pos="0 -0.25 0.472">
      <inertial mass="0.5" pos="0 0 0.02" diaginertia="0.002 0.002 0.002"/>
      <geom class="visual"    type="mesh" mesh="Base"       material="3d_printed"/>
      <geom class="visual"    type="mesh" mesh="Base_Motor" material="sts3215"/>
      <geom class="collision" type="box"  size="0.055 0.055 0.022" pos="0 0 0.011"/>

      <!-- ── Joint 1: shoulder_pan — yaw around world Z ──
           Body frame is rotated +90° around X by the euler below,
           so local Y → world Z. axis="0 1 0" in local = world Z = yaw. ✓ -->
      <body name="shoulder" pos="0 -0.0452 0.0165" euler="1.5708 0 0">
        <inertial mass="0.119" pos="0 0.059 0.031"
                  diaginertia="5.9e-05 5.9e-05 3.1e-05"/>
        <joint name="shoulder_pan" class="arm_joint"
               axis="0 1 0" range="-2.0 2.0"/>
        <geom class="visual"    type="mesh" mesh="Rotation_Pitch"       material="3d_printed"/>
        <geom class="visual"    type="mesh" mesh="Rotation_Pitch_Motor" material="sts3215"/>
          <geom class="collision" type="capsule" size="0.020"
            fromto="0 0.010 0  0 0.060 0"/>

        <!-- ── Joint 2: shoulder_lift ── -->
        <body name="upper_arm" pos="0 0.1025 0.0306" euler="-1.8 0 0">
          <inertial mass="0.162" pos="0 0.070 0.003"
                    diaginertia="2.1e-04 1.7e-04 7.0e-05"/>
          <joint name="shoulder_lift" class="arm_joint"
                 axis="1 0 0" range="0.0 3.5"/>
          <geom class="visual"    type="mesh" mesh="Upper_Arm"       material="3d_printed"/>
          <geom class="visual"    type="mesh" mesh="Upper_Arm_Motor" material="sts3215"/>
          <geom class="collision" type="capsule" size="0.025"
                fromto="0 0.005 0  0 0.100 0"/>

          <!-- ── Joint 3: elbow_flex ── -->
          <body name="lower_arm" pos="0 0.11257 0.028" euler="1.5708 0 0">
            <inertial mass="0.148" pos="0 0.001 0.077"
                      diaginertia="1.4e-04 1.1e-04 4.8e-05"/>
            <joint name="elbow_flex" class="arm_joint"
                   axis="1 0 0" range="-3.14158 0.0"/>
            <geom class="visual"    type="mesh" mesh="Lower_Arm"       material="3d_printed"/>
            <geom class="visual"    type="mesh" mesh="Lower_Arm_Motor" material="sts3215"/>
            <geom class="collision" type="capsule" size="0.022"
                  fromto="0 0.005 0  0 0.005 0.120"/>

            <!-- ── Joint 4: wrist_flex ── -->
            <body name="wrist" pos="0 0.0052 0.1349" euler="-1.0 0 0">
              <inertial mass="0.066" pos="-0.009 -0.035 0"
                        diaginertia="3.5e-05 2.4e-05 1.9e-05"/>
              <joint name="wrist_flex" class="arm_joint"
                     axis="1 0 0" range="-2.5 1.2"
                     damping="0.3" frictionloss="0.05"/>
              <geom class="visual"    type="mesh" mesh="Wrist_Pitch_Roll"       material="3d_printed"/>
              <geom class="visual"    type="mesh" mesh="Wrist_Pitch_Roll_Motor" material="sts3215"/>
              <geom class="collision" type="capsule" size="0.020"
                    fromto="0 0 0  0 -0.050 0"/>

              <!-- ── Joint 5: wrist_roll ── -->
              <body name="gripper_body" pos="0 -0.0601 0" euler="0 1.5708 0">
                <inertial mass="0.093" pos="0.006 -0.028 0"
                          diaginertia="5.0e-05 4.6e-05 2.7e-05"/>
                <joint name="wrist_roll" class="arm_joint"
                       axis="0 1 0" range="-3.14158 3.14158"
                       damping="0.3" frictionloss="0.05"/>
                <geom class="visual"   type="mesh" mesh="Fixed_Jaw"       material="3d_printed"/>
                <geom class="visual"   type="mesh" mesh="Fixed_Jaw_Motor" material="sts3215"/>
                <!-- Palm collision box -->
                <geom class="gripper_col" type="box"
                      size="0.020 0.018 0.012" pos="0 -0.030 0"/>
                    <!-- Fixed finger pad collision (tuned to visual jaw thickness) -->
                                <geom name="fixed_finger_col" class="gripper_col" type="box"
                                  size="0.0045 0.019 0.006" pos="0.002 -0.031 0"/>

                <!-- End-effector site (between fingers at tip) -->
                <site name="ee_site" pos="0 -0.072 0" size="0.007" rgba="0 1 0 1"/>
                    <!-- Grasp center used by IK to align jaw center with the block -->
                    <site name="grasp_center" pos="0 -0.045 0" size="0.004" rgba="0 1 1 1"/>
                    <!-- Fixed finger touch site -->
                    <site name="finger_tip_l" pos="0.002 -0.045 0" size="0.004" rgba="1 0 0 1"/>

                <!-- ── Joint 6: gripper jaw ── -->
                <body name="jaw" pos="-0.0202 -0.0244 0" euler="0 3.14158 0">
                  <inertial mass="0.020" pos="-0.002 -0.030 0"
                            diaginertia="1.1e-05 9.0e-06 3.0e-06"/>
                  <joint name="gripper_jaw" class="arm_joint"
                         axis="0 0 1" range="-0.2 2.0"
                         damping="0.2" frictionloss="0.05"/>
                  <geom class="visual"      type="mesh" mesh="Moving_Jaw" material="3d_printed"/>
                  <!-- Moving finger pad collision (mirrors fixed jaw pad) -->
                  <geom name="moving_finger_col" class="gripper_col" type="box"
                    size="0.0045 0.019 0.006" pos="-0.002 -0.031 0"/>
                  <!-- Moving finger touch site -->
                  <site name="finger_tip_r" pos="-0.002 -0.045 0" size="0.004" rgba="0 0 1 1"/>
                </body>

              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <!-- ── Actuators ──────────────────────────────────────────────────── -->
  <actuator>
    <position name="shoulder_pan"  joint="shoulder_pan"  class="arm_act" ctrlrange="-2.0 2.0"/>
    <position name="shoulder_lift" joint="shoulder_lift" class="arm_act" ctrlrange="0.0 3.5"/>
    <position name="elbow_flex"    joint="elbow_flex"    class="arm_act" ctrlrange="-3.14158 0.0"/>
    <position name="wrist_flex"    joint="wrist_flex"    class="arm_act" kp="40" kv="5" ctrlrange="-2.5 1.2"/>
    <position name="wrist_roll"    joint="wrist_roll"    class="arm_act" kp="40" kv="5" ctrlrange="-3.14158 3.14158"/>
    <position name="gripper_jaw"   joint="gripper_jaw"   class="arm_act" kp="35" kv="10" forcerange="-6 6" ctrlrange="-0.2 2.0"/>
  </actuator>

  <!-- ── Sensors ────────────────────────────────────────────────────── -->
  <sensor>
    <jointpos name="qpos_shoulder_pan"  joint="shoulder_pan"/>
    <jointpos name="qpos_shoulder_lift" joint="shoulder_lift"/>
    <jointpos name="qpos_elbow_flex"    joint="elbow_flex"/>
    <jointpos name="qpos_wrist_flex"    joint="wrist_flex"/>
    <jointpos name="qpos_wrist_roll"    joint="wrist_roll"/>
    <jointpos name="qpos_gripper"       joint="gripper_jaw"/>

    <jointvel name="qvel_shoulder_pan"  joint="shoulder_pan"/>
    <jointvel name="qvel_shoulder_lift" joint="shoulder_lift"/>
    <jointvel name="qvel_elbow_flex"    joint="elbow_flex"/>
    <jointvel name="qvel_wrist_flex"    joint="wrist_flex"/>
    <jointvel name="qvel_wrist_roll"    joint="wrist_roll"/>
    <jointvel name="qvel_gripper"       joint="gripper_jaw"/>

    <actuatorfrc name="frc_shoulder_pan"  actuator="shoulder_pan"/>
    <actuatorfrc name="frc_shoulder_lift" actuator="shoulder_lift"/>
    <actuatorfrc name="frc_elbow_flex"    actuator="elbow_flex"/>
    <actuatorfrc name="frc_wrist_flex"    actuator="wrist_flex"/>
    <actuatorfrc name="frc_wrist_roll"    actuator="wrist_roll"/>
    <actuatorfrc name="frc_gripper"       actuator="gripper_jaw"/>

    <framepos  name="ee_pos"  objtype="site" objname="ee_site"/>
    <framequat name="ee_quat" objtype="site" objname="ee_site"/>

    <touch name="touch_finger_l" site="finger_tip_l"/>
    <touch name="touch_finger_r" site="finger_tip_r"/>
  </sensor>

</mujoco>